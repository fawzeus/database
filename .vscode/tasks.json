{
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "group": { "kind": "build", "isDefault": true },
            "detail": "Build all modules with the root Makefile"
        },
        {
            "label": "run",
            "type": "shell",
            "command": "make run",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "detail": "Build and run build/database"
        },
        {
            "label": "check (unit tests)",
            "type": "shell",
            "command": "make check -s",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "problemMatcher": ["$gcc"],
            "detail": "Build and run every module's unit tests"
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "detail": "Remove the build directory"
        },
        {
            "label": "list modules",
            "type": "shell",
            "command": "make list-modules",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "compile active file",
            "type": "cppbuild",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always", "-g", "-std=c++17", "-Wall",
                "-I${workspaceFolder}/app/include",
                "-I${workspaceFolder}/common/include",
                "-I${workspaceFolder}/core/include",
                "-I${workspaceFolder}/sql/include",
                "-I${workspaceFolder}/catalog/include",
                "-I${workspaceFolder}/data/include",
                "-I${workspaceFolder}/storage/include",
                "-I${workspaceFolder}/index/include",
                "-I${workspaceFolder}/engine/include",
                "${file}",
                "-o", "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$gcc"],
            "detail": "Compile only the open file (use 'build' for the full project)"
        }
    ],
    "version": "2.0.0"
}
